{
  "name": "@kavishdua/proctor",
  "version": "1.1.0",
  "description": "Catch AI agents gaming their test suites: deleted tests, skipped tests, weakened assertions, hardcoded outputs",
  "homepage": "https://github.com/catfish-1234/proctor#readme",
  "bugs": {
    "url": "https://github.com/catfish-1234/proctor/issues"
  },
  "type": "module",
  "bin": {
    "proctor": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/scripts",
    "proctor.schema.json",
    "src/skill/SKILL.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catfish-1234/proctor.git"
  },
  "keywords": [
    "proctor",
    "ai",
    "testing",
    "test-tampering",
    "reward-hacking",
    "guardrails",
    "code-review",
    "git-hook",
    "pre-commit",
    "static-analysis",
    "sarif",
    "agent-skills",
    "claude",
    "claude-code",
    "cursor",
    "copilot"
  ],
  "scripts": {
    "build": "tsup",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "drift-check": "node dist/cli.js drift-check",
    "verify:pack": "bash scripts/verify-pack.sh",
    "sync-plugin": "node dist/scripts/sync-plugin.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "commander": "^15.0.0",
    "fast-glob": "3.3.3",
    "micromatch": "^4.0.8",
    "parse-diff": "0.12.0",
    "picocolors": "1.1.1"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "@types/node": "^26.1.2",
    "tsup": "8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
