{
  "name": "@kavishdua/proctor",
  "version": "1.0.0",
  "description": "Catch AI agents gaming their test suites: deleted tests, skipped tests, weakened assertions, hardcoded outputs",
  "homepage": "https://github.com/catfish-1234/proctor#readme",
  "bugs": {
    "url": "https://github.com/catfish-1234/proctor/issues"
  },
  "type": "module",
  "bin": {
    "proctor": "./dist/cli.js"
  },
  "main": "./dist/cli.js",
  "exports": {
    ".": "./dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/scripts",
    "dist/scripts/postinstall.js",
    "proctor.schema.json",
    "src/skill/SKILL.md"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catfish-1234/proctor.git"
  },
  "keywords": [
    "proctor",
    "ai",
    "testing",
    "test-tampering",
    "reward-hacking",
    "guardrails",
    "code-review",
    "git-hook",
    "pre-commit",
    "static-analysis",
    "sarif",
    "agent-skills",
    "claude",
    "claude-code",
    "cursor",
    "copilot"
  ],
  "scripts": {
    "build": "tsup",
    "bench:heldout": "node bench/heldout/probe.mjs",
    "postinstall": "node -e \"const f='dist/scripts/postinstall.js';if(require('fs').existsSync(f))require('child_process').spawnSync(process.execPath,[f],{stdio:'inherit'})\"",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "drift-check": "node dist/cli.js drift-check",
    "verify:pack": "node scripts/run-bash.mjs scripts/verify-pack.sh",
    "sync-plugin": "node dist/scripts/sync-plugin.js",
    "lint": "oxlint --deny correctness --allow no-unused-vars --allow no-useless-escape --allow prefer-string-starts-ends-with src tests scripts tsup.config.ts vitest.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "brace-expansion": "^5.0.12",
    "commander": "^14.0.3",
    "parse-diff": "0.12.0",
    "picocolors": "1.1.1",
    "picomatch": "^4.0.7",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/picomatch": "^4.0.3",
    "oxlint": "^1.88.0",
    "tsup": "8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
